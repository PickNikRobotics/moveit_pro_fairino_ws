<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr5_robot">
  <!-- Import FR5 URDF -->
  <xacro:include filename="$(find fairino_description)/urdf/fairino5_v6.urdf" />

  <!-- World link and fixed joint to base -->
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
  </joint>

  <!-- Tool flange link -->
  <link name="tool0" />
  <joint name="wrist3_link-tool0" type="fixed">
    <parent link="wrist3_link" />
    <child link="tool0" />
    <origin xyz="0 0 0.101" rpy="0 0 ${pi}" />
  </joint>

  <!-- ros2_control configuration for Fairino hardware -->
  <ros2_control name="FairinoSystem" type="system">
    <hardware>
      <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
    </hardware>
    <joint name="j1">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j2">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j3">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j4">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j5">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j6">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
  </ros2_control>
</robot>
