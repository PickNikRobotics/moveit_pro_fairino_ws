<?xml version="1.0" encoding="UTF-8"?>
<robot name="fr5_robot">
  <!-- Virtual joint to connect robot to world -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link" />

  <!-- Define the manipulator planning group -->
  <group name="manipulator">
    <chain base_link="base_link" tip_link="tool0" />
  </group>

  <!-- Named group states -->
  <group_state name="home" group="manipulator">
    <joint name="j1" value="0" />
    <joint name="j2" value="0" />
    <joint name="j3" value="0" />
    <joint name="j4" value="0" />
    <joint name="j5" value="0" />
    <joint name="j6" value="0" />
  </group_state>

  <!-- End effector group and definition -->
  <group name="hand">
    <chain base_link="wrist3_link" tip_link="tool0" />
  </group>
  <end_effector name="hand" parent_link="wrist3_link" group="hand" parent_group="manipulator" />

  <!-- Disable collisions -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="upperarm_link" reason="Never" />
  <disable_collisions link1="forearm_link" link2="shoulder_link" reason="Never" />
  <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist2_link" reason="Never" />
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never" />
  <disable_collisions link1="upperarm_link" link2="wrist1_link" reason="Never" />
  <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent" />
  <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never" />
  <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent" />

  <!-- Wrist-mounted RealSense D415 + PickNik camera adapter bracket (parented to
       tool0 on wrist3_link). These are the only two camera-side links with collision
       geometry (realsense_camera_adapter_link = bracket, wrist_mounted_camera_link =
       D415 body). Pattern mirrors the shipped core_integration_config/picknik_ur.srdf
       (gripper links omitted — this FR5 has no end-effector). Without these, the
       planner flags the rigidly-attached camera/bracket as colliding with the wrist. -->
  <disable_collisions link1="realsense_camera_adapter_link" link2="wrist_mounted_camera_link" reason="Adjacent" />
  <disable_collisions link1="realsense_camera_adapter_link" link2="wrist1_link" reason="Never" />
  <disable_collisions link1="realsense_camera_adapter_link" link2="wrist2_link" reason="Never" />
  <disable_collisions link1="realsense_camera_adapter_link" link2="wrist3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_mounted_camera_link" link2="wrist1_link" reason="Never" />
  <disable_collisions link1="wrist_mounted_camera_link" link2="wrist2_link" reason="Never" />
  <disable_collisions link1="wrist_mounted_camera_link" link2="wrist3_link" reason="Never" />
</robot>
